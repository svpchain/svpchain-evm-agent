# svpchain-evm-agent configuration.
#
# The schema is internal/config. Unknown keys are ignored rather than rejected,
# so a config still carrying keys for surfaces this agent does not serve loads
# fine. dex_chain.evm_rpc_url is REQUIRED here (the binary refuses to boot
# without it).

listen_addr = ":8083"
# How callers reach this agent; advertised in the Agent Card.
public_url  = "http://localhost:8083"

[defi_mcp]
# Private Streamable HTTP endpoint. The agent synchronizes tools/list at boot.
url = "http://127.0.0.1:18081/mcp"
# Shared secret accepted only by the private DeFi MCP. Generate a unique random
# value and configure the same value as trusted_evm_agent_token there.
auth_token = "replace-with-private-shared-secret"
timeout = "90s"

[llm]
provider = "openai"
base_url = "https://api.openai.com"
model = "gpt-5-mini"
# Name of the environment variable, never the secret itself.
api_key_env = "EVM_AGENT_LLM_API_KEY"

[dex_chain]
id          = "svpchain-testnet-1"
evm_rpc_url = "http://127.0.0.1:8545"
