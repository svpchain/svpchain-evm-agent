# scripts/deploy.sh settings. This file is sourced, not parsed; deploy.sh
# refuses it when it is group- or world-writable.
#
#   ./scripts/deploy.sh --init-config

# SSH target. Docker and Compose v2 must be usable without sudo.
SVPCHAIN_DEPLOY_HOST="www@svpdev1.example.com"

# Optional SSH jump host (ssh -J) when the deploy host is not reachable from
# this machine directly. Comma-separate to chain several hops.
# SVPCHAIN_DEPLOY_JUMP_BOX="ops@bastion.example.com"

# The chain endpoints as reached from the deploy host. The container uses host
# networking, so 127.0.0.1 means the deploy host itself.
SVPCHAIN_CHAIN_ID="svp-2517-1"
SVPCHAIN_GRPC_ADDR="127.0.0.1:9090"
SVPCHAIN_COMET_RPC="http://127.0.0.1:26657"
SVPCHAIN_INDEXER="http://127.0.0.1:3002"
SVPCHAIN_EVM_RPC="http://127.0.0.1:8545"

# The public A2A URL. Nothing is appended to it.
SVPCHAIN_EVM_AGENT_PUBLIC_URL="https://evm-agent.svpchain.org"

# Private DeFi MCP and the LLM used for natural-language A2A messages.
SVPCHAIN_DEFI_MCP_URL="http://127.0.0.1:18081/mcp"
SVPCHAIN_EVM_AGENT_LLM_API_KEY=""
#SVPCHAIN_EVM_AGENT_LLM_PROVIDER="openai"
#SVPCHAIN_EVM_AGENT_LLM_BASE_URL="https://api.openai.com"
#SVPCHAIN_EVM_AGENT_LLM_MODEL="gpt-5-mini"

# Optional EVM families.
#SVPCHAIN_EVM_UNISWAP_ROUTER="0x..."
#SVPCHAIN_EVM_WSVP="0x..."
#SVPCHAIN_EVM_UNISWAP_FACTORY="0x..."
# Stable ERC-20 aliases returned by list_evm_assets: id,address,decimals;...
#SVPCHAIN_EVM_ASSETS="usdc,0x0000000000000000000000000000000000000000,6"
#SVPCHAIN_EVM_ORACLE="0x..."
#SVPCHAIN_EVM_BRIDGE="0x..."
#SVPCHAIN_EVM_BRIDGE_ROUTES="routes.json"
#SVPCHAIN_EVM_BRIDGE_SOURCE_CHAIN_ID="2517"
#SVPCHAIN_EVM_FOREIGN_CHAINS="421614,https://example.invalid/rpc,0x..."
#SVPCHAIN_FAUCET_URL="https://pre-faucet.svpchain.org"

# Optional local state and risk controls.
#SVPCHAIN_TRANSFER_OUT_CAP_PATH="transfer-out-caps.json"
#SVPCHAIN_DEPOSIT_MAX_USDC="10000"
#SVPCHAIN_WITHDRAW_MAX_USDC="10000"
#SVPCHAIN_TRANSFER_MAX_USDC="10000"
#SVPCHAIN_DAILY_WITHDRAW_CAP_USDC="50000"

# Remote installation directory.
#SVPCHAIN_INSTALL_DIR="~/svpchain-evm-agent"

# ---- registration ----------------------------------------------------------
#
# The OWNER key: the account that registers this agent on chain, pays the
# registration fee and the bond, and controls the record thereafter. Needed
# only by --register. It is never shipped to the deployed host — the agent
# signs nothing, so a key there would be risk with no use.
#
# This one account is registered as both owner and operator, so the agent id
# (did:svp:<address>) derives from it and it can register exactly ONE agent.
# A second agent needs its own key, in its own config directory.
#
# ./scripts/deploy.sh --gen-owner-key mints one and rewrites the line below.
# Setting it by hand is fine too; this file is sourced, so it can compute the
# value rather than store it:
#   SVPCHAIN_EVM_AGENT_OWNER_KEY="$(op read op://vault/svpchain-evm-agent/owner-key)"
#SVPCHAIN_EVM_AGENT_OWNER_KEY=""

# The network AgentSettlement deployment selects its paymentToken (USDV in
# the current local PoC). x/agent stores only this advertised amount.
#SVPCHAIN_AGENT_PRICING_AMOUNT="1000000"
#SVPCHAIN_AGENT_PRICING_UNIT="call"

# gRPC endpoint reachable from THIS machine, used only by --register.
# SVPCHAIN_GRPC_ADDR above is the address the deployed container dials, which
# on a normal deployment is meaningful only on the remote host.
#SVPCHAIN_REGISTER_GRPC="grpc.testnet.svpchain.org:443"

# Public CometBFT RPC alternative for --register when gRPC is private.
#SVPCHAIN_REGISTER_RPC="https://rpc-testnet.svpchain.org"
