# Complete local agent configuration for scripts/local-evm-agent.sh.
#
# Copy this file to local-evm-agent.toml in the repository root. The file is
# intentionally ignored by Git because it names the private MCP endpoint and
# local LLM setup. Use --config-file or EVM_AGENT_LOCAL_CONFIG_FILE to keep it
# elsewhere.
#
# The launcher copies this file to build/local-evm-agent/agent.toml. Change
# the RPC endpoints here when your local chain uses non-default ports.

listen_addr = "127.0.0.1:8083"
# For a Docker consumer on macOS, use http://host.docker.internal:8083.
public_url  = "http://localhost:8083"

[defi_mcp]
url = "http://127.0.0.1:18081/mcp"
timeout = "90s"

[llm]
provider = "openai"
base_url = "https://api.openai.com"
model = "gpt-5-mini"
api_key_env = "EVM_AGENT_LLM_API_KEY"

[dex_chain]
id          = "svp-2517-1"
evm_rpc_url = "http://127.0.0.1:8545"
