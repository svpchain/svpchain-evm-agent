# Optional EVM contract directory. Configure it in one of two ways:
#
# Local development:
#   ./scripts/local-evm-agent.sh start \
#     --contracts-file ./contracts.toml \
#     --operator-key-file ./operator.key
#
# Deployment config (~/.config/svpchain-evm-agent/config.sh):
#   SVPCHAIN_EVM_CONTRACTS_FILE="$HOME/.config/svpchain-evm-agent/contracts.toml"
#
# This is a small operator-maintained discovery list, not a chain index and
# not a delegation allowlist. Its methods list is the whitelist for
# execute_evm_contract_method. An address listed here must still be present in
# both the root delegation and the SVP-DT task credential's contracts limit.
# Addresses must use lowercase canonical 0x form.

[[evm.contract]]
id          = "usdc"
address     = "0x000000000000000000000000000000000000c07e"
kind        = "erc20"
symbol      = "USDC"
decimals    = 6
methods     = ["transfer(address,uint256)", "approve(address,uint256)"]
description = "Replace with the local or testnet USDC deployment."

[[evm.contract]]
id          = "swap-router"
address     = "0x000000000000000000000000000000000000cafe"
kind        = "uniswap-v2-router"
methods = [
  "swapExactSVPForTokens(uint256,address[],address,uint256)",
  "swapExactTokensForSVP(uint256,uint256,address[],address,uint256)",
  "swapExactTokensForTokens(uint256,uint256,address[],address,uint256)"
]
description = "Replace with the reviewed swap-router deployment."

[[evm.contract]]
id          = "bridge"
address     = "0x000000000000000000000000000000000000babe"
kind        = "bridge"
methods     = ["bridgeTokens(address,uint256,uint16,bytes32)"]
description = "Replace with the reviewed bridge deployment."
